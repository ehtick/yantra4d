{
  "project": {
    "name": "Tablaco v2",
    "slug": "tablaco-v2",
    "version": "0.1.0",
    "engine": "cadquery",
    "force_backend": true,
    "difficulty": "intermediate",
    "description": {
      "en": "Tablaco v2 — a truth table you can hold (first iteration). Each cell is a cube of two press-fit half-shells (white = V, dark = F) that slide and rotate on a vertical rail; the presented face carries a tactile glyph — V sunken, F raised — so the value is read by fingertip before the letter. The Panel view assembles the canonical 8x8 matrix. CadQuery B-Rep, FDM. (c) Xochitl Martinez Nava; MADFAM portfolio licence.\n\nOfficial Visualizer and Configurator: Yantra4D",
      "es": "Tablaco v2 — una tabla de verdad que puedes sostener (primera iteracion). Cada celda es un cubo de dos medias conchas a presion (blanco = V, oscuro = F) que desliza y gira sobre un riel vertical; la cara presentada lleva un glifo tactil — V hundida, F en relieve — para resolver el valor con la yema antes de leer la letra. La vista Tablero arma la matriz canonica 8x8. CadQuery B-Rep, FDM. (c) Xochitl Martinez Nava; licencia de portafolio MADFAM.\n\nVisualizador y configurador oficial: Yantra4D"
    },
    "tags": ["tablaco", "logic", "truth-table", "education", "tactile", "accessibility", "cadquery"],
    "hyperobject": { "is_hyperobject": false }
  },
  "modes": [
    {
      "id": "unit",
      "label": { "en": "Unit (cell)", "es": "Unidad (celda)" },
      "scad_file": "main.py",
      "cq_file": "main.py",
      "parts": ["cell_v", "cell_f", "rod"],
      "estimate": { "base_time": 12, "per_unit": 3, "per_part": 8 }
    },
    {
      "id": "half_shell",
      "label": { "en": "Half-shell", "es": "Media concha" },
      "scad_file": "main.py",
      "cq_file": "main.py",
      "parts": ["shell"],
      "estimate": { "base_time": 8, "per_unit": 2, "per_part": 8 }
    },
    {
      "id": "panel",
      "label": { "en": "Panel (8x8)", "es": "Tablero (8x8)" },
      "scad_file": "main.py",
      "cq_file": "main.py",
      "parts": ["board", "rails", "cells_light", "cells_dark"],
      "estimate": { "base_time": 25, "per_unit": 4, "per_part": 14 }
    }
  ],
  "parts": [
    { "id": "cell_v", "label": { "en": "V half-shell (white)", "es": "Media concha V (blanca)" }, "render_mode": 0, "color": "#eef0ee" },
    { "id": "cell_f", "label": { "en": "F half-shell (dark)", "es": "Media concha F (oscura)" }, "render_mode": 0, "color": "#26262b" },
    { "id": "rod", "label": { "en": "Rail", "es": "Riel" }, "render_mode": 0, "color": "#8b9099" },
    { "id": "shell", "label": { "en": "Half-shell", "es": "Media concha" }, "render_mode": 0, "color": "#eef0ee" },
    { "id": "board", "label": { "en": "Backing board", "es": "Tablero base" }, "render_mode": 0, "color": "#c7a76a" },
    { "id": "rails", "label": { "en": "Rails", "es": "Rieles" }, "render_mode": 0, "color": "#8b9099" },
    { "id": "cells_light", "label": { "en": "Cells — V faces (white)", "es": "Celdas — caras V (blanco)" }, "render_mode": 0, "color": "#eef0ee" },
    { "id": "cells_dark", "label": { "en": "Cells — F faces (dark)", "es": "Celdas — caras F (oscuro)" }, "render_mode": 0, "color": "#26262b" }
  ],
  "parameter_groups": [
    { "id": "cube", "label": { "en": "Cell", "es": "Celda" } },
    { "id": "panel", "label": { "en": "Panel", "es": "Tablero" } }
  ],
  "parameters": [
    { "id": "cell", "type": "slider", "default": 18.0, "min": 12.0, "max": 28.0, "step": 0.5, "group": "cube", "modes": ["unit", "half_shell", "panel"], "label": { "en": "Cell size (mm)", "es": "Tamano de celda (mm)" }, "tooltip": { "en": "Cube edge length", "es": "Arista del cubo" } },
    { "id": "rod_dia", "type": "slider", "default": 5.0, "min": 3.0, "max": 8.0, "step": 0.5, "group": "cube", "modes": ["unit", "half_shell", "panel"], "label": { "en": "Rail diameter (mm)", "es": "Diametro del riel (mm)" }, "tooltip": { "en": "Diameter of the vertical rail the cell rides on", "es": "Diametro del riel vertical sobre el que corre la celda" } },
    { "id": "clearance", "type": "slider", "default": 0.35, "min": 0.1, "max": 0.8, "step": 0.05, "group": "cube", "modes": ["unit", "half_shell", "panel"], "advanced": true, "label": { "en": "Rail clearance (mm)", "es": "Holgura del riel (mm)" }, "tooltip": { "en": "Slide fit of the bore over the rail — must never jam (Decision #17)", "es": "Ajuste deslizante del barreno sobre el riel — nunca debe atorarse (Decision #17)" } },
    { "id": "glyph", "type": "slider", "default": 1.4, "min": 0.6, "max": 3.0, "step": 0.1, "group": "cube", "modes": ["unit", "half_shell"], "label": { "en": "Glyph relief (mm)", "es": "Relieve del glifo (mm)" }, "tooltip": { "en": "Depth of the sunken V / height of the raised F", "es": "Profundidad de la V hundida / altura de la F en relieve" } },
    { "id": "corner", "type": "slider", "default": 1.6, "min": 0.0, "max": 4.0, "step": 0.1, "group": "cube", "modes": ["unit", "half_shell", "panel"], "label": { "en": "Edge rounding (mm)", "es": "Redondeo de aristas (mm)" }, "tooltip": { "en": "Fillet on the outer vertical edges", "es": "Redondeo de las aristas verticales externas" } },
    { "id": "pitch", "type": "slider", "default": 20.0, "min": 16.0, "max": 30.0, "step": 0.5, "group": "panel", "modes": ["panel"], "label": { "en": "Grid pitch (mm)", "es": "Paso de la reticula (mm)" }, "tooltip": { "en": "Centre-to-centre spacing of cells on the panel", "es": "Separacion centro a centro de las celdas en el tablero" } },
    { "id": "rows", "type": "slider", "default": 8, "min": 1, "max": 8, "step": 1, "group": "panel", "modes": ["panel"], "label": { "en": "Rows (assignments)", "es": "Filas (asignaciones)" }, "tooltip": { "en": "Truth-table rows; 8 = the canonical 2^3 matrix", "es": "Filas de la tabla; 8 = la matriz canonica 2^3" } },
    { "id": "cols", "type": "slider", "default": 8, "min": 1, "max": 8, "step": 1, "group": "panel", "modes": ["panel"], "label": { "en": "Columns", "es": "Columnas" }, "tooltip": { "en": "First 3 columns are the p,q,r inputs; the rest stay neutral", "es": "Las primeras 3 columnas son las entradas p,q,r; el resto quedan neutras" } }
  ],
  "presets": [
    { "id": "standard_cell", "mode": "unit", "label": { "en": "Standard cell (18 mm)", "es": "Celda estandar (18 mm)" }, "values": { "cell": 18.0, "rod_dia": 5.0, "glyph": 1.4, "corner": 1.6 } },
    { "id": "canonical_panel", "mode": "panel", "label": { "en": "Canonical 8x8 panel", "es": "Tablero canonico 8x8" }, "values": { "cell": 18.0, "pitch": 20.0, "rows": 8, "cols": 8 } },
    { "id": "minimal_panel", "mode": "panel", "label": { "en": "Minimal 4x4 (2 vars)", "es": "Minimo 4x4 (2 vars)" }, "values": { "cell": 18.0, "pitch": 20.0, "rows": 4, "cols": 4 } }
  ],
  "camera_views": [
    { "id": "iso", "label": { "en": "Isometric", "es": "Isometrico" }, "position": [90, 90, 70] },
    { "id": "front", "label": { "en": "Front", "es": "Frente" }, "position": [0, 160, 0] },
    { "id": "top", "label": { "en": "Top", "es": "Superior" }, "position": [0, 0, 180] }
  ],
  "export_formats": ["stl", "step", "glb", "3mf"],
  "estimate_constants": { "base_time": 3, "per_unit": 1, "per_part": 2, "fn_factor": 32, "wasm_multiplier": 1, "warning_threshold_seconds": 180 },
  "tags": ["tablaco", "logic", "truth-table", "education", "tactile", "accessibility", "cadquery"]
}
